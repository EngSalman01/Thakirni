# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI (Google Gemini) ──────────────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── WhatsApp (Kapso) ────────────────────────────────────────────────────────
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_PHONE_NUMBER_ID=

# ─── Payments (Paddle) ───────────────────────────────────────────────────────
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_SECRET_KEY=
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=

# Paddle Price IDs (create in Paddle Dashboard)
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_ANNUAL=
PADDLE_PRICE_TEAMS_MONTHLY=
PADDLE_PRICE_TEAMS_ANNUAL=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Backend server ──────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Google Calendar OAuth ───────────────────────────────────────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials
# Enable "Google Calendar API", add redirect URI: http://localhost:3000/api/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
